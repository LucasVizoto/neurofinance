PORT=3005
JWT_SECRET=
# Docker: http://neuro-backend:3001  |  Local: http://localhost:3001
USERS_SERVICE_URL=
# Docker: http://neuro-learning:5000  |  Local: http://localhost:5000
AI_SERVICE_URL=
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly one Authorized redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3005/auth/google/callback

# http = proxy HTTP interno. amqp = RPC via RabbitMQ (padrão do Compose).
MESSAGING=http
RABBITMQ_URL=amqp://neuro:change-me-rabbit-password@localhost:5672/neurofinance
RABBITMQ_EXCHANGE=neurofinance.topic
RABBITMQ_RPC_TIMEOUT_BACKEND_MS=10000
RABBITMQ_RPC_TIMEOUT_LEARNING_MS=180000
