# Copy to ".env" in this directory before: docker compose up -d --build
# Connection URLs are assembled in docker-compose.yml using the container DNS names.
# Do not use localhost as the database host inside containers.

# --- Postgres (service: postgres-db) ---
POSTGRES_USER=neuro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=neuro-backend

# --- Auth (must be the same in gateway and backend) ---
JWT_SECRET=change-me-long-random-jwt-secret

# --- Public URLs (browser + Google OAuth). Replace with your VPS IP or domain. ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3000
GOOGLE_CALLBACK_URL=http://localhost:3005/auth/google/callback
CORS_ORIGIN=http://localhost:3000

# --- Google OAuth (gateway) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI / market data (neuro-learning) ---
GEMINI_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Optional: Supabase avatars (neuro-backend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
